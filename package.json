{
  "name": "bruno-garden",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "content": "tsx scripts/build-content.ts",
    "content:watch": "tsx scripts/build-content.ts --watch",
    "report": "tsx scripts/report.ts",
    "predev": "npm run content",
    "dev": "concurrently --kill-others --names content,next \"npm:content:watch\" \"next dev\"",
    "prebuild": "npm run content -- --production",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@mdx-js/mdx": "^3.1.1",
    "gray-matter": "^4.0.3",
    "image-size": "^2.0.4",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-force-graph-2d": "^1.29.2",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "server-only": "^0.0.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
